<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	document.addEventListener("astro:page-load", () => {
		// Clean up any stale ScrollTriggers
		ScrollTrigger.getAll().forEach(t => t.kill());

		// --- Hero Animations ---
		const tl = gsap.timeline();
		
		tl.fromTo(".hero-text-line", 
			{ yPercent: 120, rotationZ: 5, opacity: 0 },
			{ yPercent: 0, rotationZ: 0, opacity: 1, duration: 1.2, ease: "power4.out", stagger: 0.15 }
		)
		.fromTo(".hero-desc",
			{ y: 30, opacity: 0 },
			{ y: 0, opacity: 1, duration: 1, ease: "power3.out" },
			"-=0.8"
		)
		.to(".hero-glow", { opacity: 1, duration: 2 }, "-=1");

		// Parallax Text
		const moveTextX = gsap.quickTo(".hero-parallax-wrapper", "x", { duration: 0.8, ease: "power2" });
		const moveTextY = gsap.quickTo(".hero-parallax-wrapper", "y", { duration: 0.8, ease: "power2" });

		window.addEventListener('mousemove', (e) => {
			const xCenter = window.innerWidth / 2;
			const yCenter = window.innerHeight / 2;
			moveTextX((e.clientX - xCenter) * -0.02);
			moveTextY((e.clientY - yCenter) * -0.02);
		});

		// Animación de los Títulos de Sección
		gsap.utils.toArray(".section-title").forEach((title: any) => {
			gsap.fromTo(title, 
				{ y: 60, opacity: 0 },
				{
					y: 0,
					opacity: 1,
					duration: 0.8,
					ease: "power3.out",
					scrollTrigger: {
						trigger: title,
						start: "top 90%",
						once: true
					}
				}
			);
		});

		// Animación Pop-up de las tarjetas al hacer Scroll
		const projects = gsap.utils.toArray(".project-card");
		projects.forEach((project: any) => {
			gsap.fromTo(project, 
				{ y: 60, opacity: 0 },
				{
					y: 0,
					opacity: 1,
					duration: 0.8,
					ease: "power3.out",
					scrollTrigger: {
						trigger: project,
						start: "top 90%",
						once: true
					}
				}
			);
		});

		// Animación de las Skills (siempre visibles, animación suave al entrar)
		gsap.from(".skill-card", {
			y: 25,
			duration: 0.5,
			stagger: 0.06,
			ease: "power2.out",
			scrollTrigger: {
				trigger: "#about",
				start: "top 85%",
				once: true
			}
		});

		// Refresh triggers dynamically when DOM/images settle
		setTimeout(() => {
			ScrollTrigger.refresh();
		}, 100);

		window.addEventListener("load", () => {
			ScrollTrigger.refresh();
		}, { once: true });
	});
</script>
























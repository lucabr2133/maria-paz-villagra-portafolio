							<div class="flex flex-wrap gap-4 md:gap-8 lg:gap-12 text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-white/80 font-mono drop-shadow-md">
								<span>SALTA, ARG</span>
								<span class="hidden sm:inline">VÍA PÚBLICA</span>
								<span>2026</span>
							</div>
						</div>
					</div>
				</a>

				<a href="/work/cosalta" class="project-card block relative w-full h-[60vh] min-h-[420px] max-h-[650px] lg:h-screen group overflow-hidden cursor-pointer border-b border-black/20">

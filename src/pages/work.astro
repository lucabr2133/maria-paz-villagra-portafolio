						<img src="/portfolio/tijuana.jpeg" alt="Tijuana" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-[2s] ease-out" />
					</div>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent lg:hidden pointer-events-none"></div>
					<div class="absolute inset-0 bg-black/40 hidden lg:block pointer-events-none"></div>
					
					<div class="project-text-block absolute bottom-6 md:bottom-8 lg:bottom-12 left-0 w-full px-6 md:px-12 z-10">
						<div class="flex flex-col md:flex-row md:items-baseline justify-between border-b border-white/30 pb-4 gap-2 md:gap-4 lg:gap-6">
							<h3 class="text-2xl sm:text-3xl lg:text-5xl font-sans font-bold tracking-tight text-white drop-shadow-md group-hover:pl-4 transition-all duration-500">Tijuana Showroom</h3>
							<div class="flex flex-wrap gap-4 md:gap-8 lg:gap-12 text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-white/80 font-mono drop-shadow-md">
								<span>SALTA, ARG</span>

			<div class="md:w-1/3 flex items-center">
				<div class="flex flex-col items-center justify-center translate-y-1">
					<span class="font-logo text-3xl md:text-4xl text-black leading-none lowercase tracking-normal">pazstudio</span>
					<span class="font-sans font-black text-[7px] md:text-[9px] tracking-[0.3em] text-black uppercase ml-4 -mt-1">DISEÑADORA</span>
				</div>
			</div>
			<div class="hidden md:flex gap-8 text-sm text-black/60 justify-center md:w-1/3">
				<a href="/" class="hover:text-[#a20007] transition-colors">Inicio</a>
				<a href="/work" class="hover:text-[#a20007] transition-colors text-black">Proyectos</a>
				<a href="/#about" class="hover:text-[#a20007] transition-colors">Sobre Mí</a>
			</div>
			<div class="text-sm text-right md:w-1/3">
				<a href="https://wa.me/5493874043600?text=Hola%20Paz,%20vi%20tu%20portfolio%20y%20me%20gustar%C3%ADa%20hacerte%20una%20consulta." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-[#25D366] transition-colors uppercase tracking-widest text-[10px] font-semibold">
					<WhatsAppIcon class="w-3.5 h-3.5" />
					WhatsApp
				</a>
			</div>
		</nav>

		<main class="w-full pt-32 overflow-x-hidden">
			

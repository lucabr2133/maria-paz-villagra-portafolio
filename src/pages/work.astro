</Layout>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	function initWorkAnimations() {
		// Limpieza de triggers previos para navegaciones con View Transitions
		ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

		// Garantizar que los bloques de texto estén 100% visibles y limpios de cualquier opacity 0 previa
		const textBlocks = gsap.utils.toArray<HTMLElement>('.project-text-block');
		textBlocks.forEach((block) => {
			gsap.set(block, { opacity: 1, y: 0, clearProps: "opacity,transform" });
		});

		const mm = gsap.matchMedia();

		// PANTALLAS GRANDES (Desktop / Laptop >= 1024px) -> Parallax de fondo
		mm.add("(min-width: 1024px)", () => {
			const cards = gsap.utils.toArray<HTMLElement>('.project-card');
			cards.forEach((card) => {
				const wrapper = card.querySelector('.parallax-wrapper');
				if (wrapper) {
					gsap.fromTo(wrapper, 
						{ y: "-30vh" },
						{
							y: "30vh",
							ease: "none",
							scrollTrigger: {
								trigger: card,
								start: "top bottom",
								end: "bottom top",
								scrub: 0.6  
							}
						}
					);
				}
			});
		});

		// CELULARES Y TABLETS (< 1024px) -> Parallax fluido calibrado sin recortar las imágenes
		mm.add("(max-width: 1023px)", () => {
			const cards = gsap.utils.toArray<HTMLElement>('.project-card');
			cards.forEach((card) => {
				const wrapper = card.querySelector('.parallax-wrapper');
				if (wrapper) {
					gsap.fromTo(wrapper, 
						{ yPercent: -10 },
						{
							yPercent: 10,
							ease: "none",
							scrollTrigger: {
								trigger: card,
								start: "top bottom",
								end: "bottom top",
								scrub: 0.6  
							}
						}
					);
				}
			});
		});

		// Animación del título de la página
		gsap.from("h1", {
			y: 100,
			opacity: 0,
			duration: 1.2,
			ease: "power3.out",
			scrollTrigger: {
				trigger: "h1",
				start: "top 90%",
				toggleActions: "play none none none"
			}
		});

		// Control dinámico de las letras del header (Negro arriba, Blanco sobre las imágenes)
		const nav = document.getElementById("work-nav");
		const cardsContainer = document.getElementById("cards-container");

		if (nav && cardsContainer) {
			const updateNavColor = () => {
				const rect = cardsContainer.getBoundingClientRect();
				// Cuando las imágenes pasan bajo el navbar (~70px del top)
				if (rect.top <= 70) {
					nav.classList.add("header-on-image");
				} else {
					nav.classList.remove("header-on-image");
				}
			};

			window.addEventListener("scroll", updateNavColor, { passive: true });
			window.addEventListener("resize", updateNavColor, { passive: true });
			updateNavColor();
		}

		// Refresh triggers tras asentar el DOM
		requestAnimationFrame(() => {
			ScrollTrigger.refresh();
		});
		setTimeout(() => {
			ScrollTrigger.refresh();
		}, 150);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initWorkAnimations);
	} else {
		initWorkAnimations();
	}
	document.addEventListener("astro:page-load", initWorkAnimations);
	document.addEventListener("astro:before-swap", () => {
		ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
	});
</script>

<style>
	#work-nav.header-on-image .nav-brand {
		color: #ffffff !important;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
	}
	#work-nav.header-on-image .nav-sub {
		color: rgba(255, 255, 255, 0.85) !important;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
	}
	#work-nav.header-on-image .nav-link {
		color: rgba(255, 255, 255, 0.75) !important;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
	}
	#work-nav.header-on-image .nav-link:hover {
		color: #ffffff !important;
	}
	#work-nav.header-on-image .nav-link-active {
		color: #ffffff !important;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
	}
	#work-nav.header-on-image .nav-wa {
		color: #ffffff !important;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
	}
	#work-nav.header-on-image .nav-wa:hover {
		color: #25D366 !important;
	}
</style>














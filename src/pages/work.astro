						</div>
					</div>
				</a>

				<a href="/work/majo-marketing" class="project-card block relative w-full h-[60vh] min-h-[420px] max-h-[650px] lg:h-screen group overflow-hidden cursor-pointer border-b border-black/20">
					<div class="parallax-wrapper absolute -top-[12%] left-0 w-full h-[124%] lg:-top-[30vh] lg:h-[160vh] will-change-transform">
						<img src="/portfolio/proj5.jpg" alt="Majo Marketing" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out" />

				</div>
			</a>
			<div class="hidden md:flex gap-8 text-sm justify-center md:w-1/3 font-medium">
				<a href="/" class="nav-link text-black/60 hover:text-[#a20007] transition-colors duration-300">Inicio</a>
				<a href="/work" class="nav-link-active text-black hover:text-[#a20007] transition-colors duration-300 font-semibold">Proyectos</a>
				<a href="/#about" class="nav-link text-black/60 hover:text-[#a20007] transition-colors duration-300">Sobre Mí</a>
			</div>
			<div class="text-sm text-right md:w-1/3">

					<div class="parallax-wrapper absolute -top-[12%] left-0 w-full h-[124%] lg:-top-[30vh] lg:h-[160vh] will-change-transform">
						<img src="/portfolio/A3.png" alt="Tracción Norte" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out" />

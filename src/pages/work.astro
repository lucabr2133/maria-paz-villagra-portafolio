---
import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../components/icons/whatsapp.astro';
---

<Layout title="Proyectos | Maria Paz Villagra">
	<div class="min-h-screen text-black selection:bg-[#a20007]/20 selection:text-[#a20007] font-sans font-light">
		
		{/* Navbar Minimalista */}

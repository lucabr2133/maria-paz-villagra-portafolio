						<img src="/portfolio/YouKnow Tour (1).png" alt="YouKnow Tour" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out" />
					</div>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent pointer-events-none"></div>
					
					<div class="project-text-block absolute bottom-6 md:bottom-12 left-0 w-full px-6 md:px-12 z-10">
						<div class="flex flex-col md:flex-row md:items-baseline justify-between border-b border-white/30 pb-4 gap-2 md:gap-6">
							<h3 class="text-2xl sm:text-3xl md:text-5xl font-sans font-bold tracking-tight text-white drop-shadow-md group-hover:pl-4 transition-all duration-500">YouKnow Tour | Cartelería</h3>
							<div class="flex flex-wrap gap-4 md:gap-12 text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-white/80 font-mono drop-shadow-md">
								<span>SALTA, ARG</span>
								<span class="hidden sm:inline">VÍA PÚBLICA</span>
								<span>2026</span>
							</div>
						</div>
					</div>
				</a>

				<a href="/work/cosalta" class="project-card block relative w-full h-[58vh] min-h-[420px] max-h-[640px] md:h-screen group overflow-hidden cursor-pointer border-b border-black/20">
					<div class="parallax-wrapper relative md:absolute top-0 md:-top-[30vh] left-0 w-full h-full md:h-[160vh] will-change-transform">
						<img src="/portfolio/Cosalta (2).png" alt="Cosalta" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out" />
					</div>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent pointer-events-none"></div>
					
					<div class="project-text-block absolute bottom-6 md:bottom-12 left-0 w-full px-6 md:px-12 z-10">
						<div class="flex flex-col md:flex-row md:items-baseline justify-between border-b border-white/30 pb-4 gap-2 md:gap-6">
							<h3 class="text-2xl sm:text-3xl md:text-5xl font-sans font-bold tracking-tight text-white drop-shadow-md group-hover:pl-4 transition-all duration-500">Cosalta | Momy Yogur</h3>
							<div class="flex flex-wrap gap-4 md:gap-12 text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-white/80 font-mono drop-shadow-md">
								<span>SALTA, ARG</span>

				</a>

				<a href="/work/traccion-norte" class="project-card block relative w-full h-[58vh] min-h-[420px] max-h-[640px] md:h-screen group overflow-hidden cursor-pointer border-b border-black/20">
					<div class="parallax-wrapper relative md:absolute top-0 md:-top-[30vh] left-0 w-full h-full md:h-[160vh] will-change-transform">
						<img src="/portfolio/A3.png" alt="Tracción Norte" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out" />
					</div>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent pointer-events-none"></div>
					
					<div class="project-text-block absolute bottom-6 md:bottom-12 left-0 w-full px-6 md:px-12 z-10">
						<div class="flex flex-col md:flex-row md:items-baseline justify-between border-b border-white/30 pb-4 gap-2 md:gap-6">
							<h3 class="text-2xl sm:text-3xl md:text-5xl font-sans font-bold tracking-tight text-white drop-shadow-md group-hover:pl-4 transition-all duration-500">Tracción Norte</h3>
							<div class="flex flex-wrap gap-4 md:gap-12 text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-white/80 font-mono drop-shadow-md">
								<span>SALTA, ARG</span>
								<span class="hidden sm:inline">SOCIAL MEDIA</span>
								<span>2026</span>
							</div>
						</div>
					</div>
				</a>

				<a href="/work/bunker" class="project-card block relative w-full h-[58vh] min-h-[420px] max-h-[640px] md:h-screen group overflow-hidden cursor-pointer border-b border-black/20">
					<div class="parallax-wrapper relative md:absolute top-0 md:-top-[30vh] left-0 w-full h-full md:h-[160vh] will-change-transform">
						<img src="/portfolio/bunkerOwl.png" alt="Bunker" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out" />
					</div>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent pointer-events-none"></div>
					
					<div class="project-text-block absolute bottom-6 md:bottom-12 left-0 w-full px-6 md:px-12 z-10">
						<div class="flex flex-col md:flex-row md:items-baseline justify-between border-b border-white/30 pb-4 gap-2 md:gap-6">
							<h3 class="text-2xl sm:text-3xl md:text-5xl font-sans font-bold tracking-tight text-white drop-shadow-md group-hover:pl-4 transition-all duration-500">Bunker</h3>
							<div class="flex flex-wrap gap-4 md:gap-12 text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-white/80 font-mono drop-shadow-md">
								<span>Redes Sociales</span>
								<span>2026</span>
							</div>
						</div>
					</div>
				</a>

			</div>
		</main>
	</div>
</Layout>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	document.addEventListener("astro:page-load", () => {
		// Limpieza de triggers previos para navegaciones con View Transitions
		ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

		const mm = gsap.matchMedia();

		// Parallax cinematográfico solo en pantallas de escritorio / tablet horizontal
		mm.add("(min-width: 768px)", () => {
			const cards = gsap.utils.toArray<HTMLElement>('.project-card');
			cards.forEach((card) => {
				const wrapper = card.querySelector('.parallax-wrapper');
				if (wrapper) {
					gsap.fromTo(wrapper, 
						{ y: "-25vh" },
						{
							y: "25vh",
							ease: "none",
							scrollTrigger: {
								trigger: card,
								start: "top bottom",
								end: "bottom top",
								scrub: 0.6  
							}
						}
					);
				}
			});
		});

		// Animación suave de textos para mobile y desktop
		const cards = gsap.utils.toArray<HTMLElement>('.project-card');
		cards.forEach((card) => {
			const textBlock = card.querySelector('.project-text-block');
			if (textBlock) {
				gsap.fromTo(textBlock,
					{ opacity: 0, y: 35 },
					{
						opacity: 1,
						y: 0,
						duration: 0.8,
						ease: "power2.out",
						scrollTrigger: {
							trigger: card,
							start: "top 85%",
							toggleActions: "play none none reverse"
						}
					}
				);
			}
		});

		gsap.from("h1", {
			y: 60,
			opacity: 0,
			duration: 1,
			ease: "power3.out",
			scrollTrigger: {
				trigger: "h1",
				start: "top 95%",
				toggleActions: "play none none none"
			}
		});

		ScrollTrigger.refresh();
	});
</script>













